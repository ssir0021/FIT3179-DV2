{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "width": 650,
    "height": 360,

    "title": {
      "text": "Year 3 reading rankings stayed mostly stable from 2023 to 2025",
      "subtitle": "Victoria remained first, while Queensland overtook Western Australia in 2025",
      "anchor": "start",
      "fontSize": 22,
      "subtitleFontSize": 13,
      "subtitlePadding": 8
    },

    "data": {
      "url": "data/naplan_states.csv",
      "format": {
        "type": "csv",
        "parse": {
          "calendar_year": "number",
          "year_level": "number",
          "average_score": "number"
        }
      }
    },

    "transform": [
      {
        "filter": "datum.calendar_year >= 2023 && datum.calendar_year <= 2025 && datum.year_level == 3 && datum.domain == 'Reading' && datum.state_territory != 'Australia'"
      },

      {
        "window": [
          {
            "op": "rank",
            "as": "rank"
          }
        ],
        "sort": [
          {
            "field": "average_score",
            "order": "descending"
          }
        ],
        "groupby": [
          "calendar_year"
        ]
      }
    ],

    "layer": [
      {
        "mark": {
          "type": "line",
          "strokeWidth": 3
        },

        "encoding": {
          "x": {
            "field": "calendar_year",
            "type": "ordinal",
            "title": "NAPLAN year",
            "sort": [2023, 2024, 2025],
            "axis": {
              "labelAngle": 0
            }
          },

          "y": {
            "field": "rank",
            "type": "quantitative",
            "title": "Reading rank",
            "scale": {
              "domain": [8, 1]
            },
            "axis": {
              "values": [1, 2, 3, 4, 5, 6, 7, 8],
              "tickMinStep": 1
            }
          },

          "color": {
            "field": "state_territory",
            "type": "nominal",
            "title": "State / Territory",
            "scale": {
              "scheme": "tableau10"
            }
          },

          "detail": {
            "field": "state_territory"
          }
        }
      },

      {
        "mark": {
          "type": "point",
          "filled": true,
          "size": 120,
          "stroke": "white",
          "strokeWidth": 1
        },

        "encoding": {
          "x": {
            "field": "calendar_year",
            "type": "ordinal",
            "sort": [2023, 2024, 2025]
          },

          "y": {
            "field": "rank",
            "type": "quantitative",
            "scale": {
              "domain": [8, 1]
            }
          },

          "color": {
            "field": "state_territory",
            "type": "nominal",
            "scale": {
              "scheme": "tableau10"
            }
          },

          "tooltip": [
            {
              "field": "state_territory",
              "type": "nominal",
              "title": "State / Territory"
            },
            {
              "field": "calendar_year",
              "type": "ordinal",
              "title": "Year"
            },
            {
              "field": "rank",
              "type": "quantitative",
              "title": "Rank",
              "format": ".0f"
            },
            {
              "field": "average_score",
              "type": "quantitative",
              "title": "Average Reading score",
              "format": ".1f"
            }
          ]
        }
      },

      {
        "transform": [
          {
            "filter": "datum.calendar_year == 2025"
          }
        ],

        "mark": {
          "type": "text",
          "align": "left",
          "dx": 10,
          "fontSize": 11,
          "fontWeight": "bold"
        },

        "encoding": {
          "x": {
            "field": "calendar_year",
            "type": "ordinal",
            "sort": [2023, 2024, 2025]
          },

          "y": {
            "field": "rank",
            "type": "quantitative",
            "scale": {
              "domain": [8, 1]
            }
          },

          "text": {
            "field": "state_territory"
          },

          "color": {
            "field": "state_territory",
            "type": "nominal",
            "scale": {
              "scheme": "tableau10"
            }
          }
        }
      }
    ],

    "config": {
      "view": {
        "stroke": null
      },

      "legend": {
        "orient": "bottom",
        "columns": 4
      },

      "axis": {
        "labelFontSize": 12,
        "titleFontSize": 13
      }
    }
  }
