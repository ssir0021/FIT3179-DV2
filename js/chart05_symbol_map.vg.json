{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "width": 650,
    "height": 500,

    "title": {
      "text": "The largest student cohorts are concentrated in the eastern states",
      "subtitle": "Year 3 Numeracy — circle size shows enrolled students; colour shows average score, 2025",
      "anchor": "start",
      "fontSize": 22,
      "subtitleFontSize": 13,
      "subtitlePadding": 8
    },

    "projection": {
      "type": "equalEarth"
    },

    "layer": [
      {
        "data": {
          "url": "data/australia_states_simplified.geojson",
          "format": {
            "type": "json",
            "property": "features"
          }
        },

        "mark": {
          "type": "geoshape",
          "fill": "#eeeeee",
          "stroke": "#ffffff",
          "strokeWidth": 1
        }
      },

      {
        "data": {
          "url": "data/naplan_states.csv",
          "format": {
            "type": "csv",
            "parse": {
              "calendar_year": "number",
              "year_level": "number",
              "average_score": "number",
              "enrolled_students": "number",
              "participation_pct": "number"
            }
          }
        },

        "transform": [
          {
            "filter": "datum.calendar_year == 2025 && datum.year_level == 3 && datum.domain == 'Numeracy'"
          },

          {
            "lookup": "state_territory",
            "from": {
              "data": {
                "url": "data/australia_states_simplified.geojson",
                "format": {
                  "type": "json",
                  "property": "features"
                }
              },
              "key": "properties.state_name"
            },
            "as": "geo"
          },

          {
            "calculate": "geoCentroid(null, datum.geo)[0]",
            "as": "longitude"
          },

          {
            "calculate": "geoCentroid(null, datum.geo)[1]",
            "as": "latitude"
          }
        ],

        "mark": {
          "type": "circle",
          "opacity": 0.8,
          "stroke": "white",
          "strokeWidth": 1
        },

        "encoding": {
          "longitude": {
            "field": "longitude",
            "type": "quantitative"
          },

          "latitude": {
            "field": "latitude",
            "type": "quantitative"
          },

          "size": {
            "field": "enrolled_students",
            "type": "quantitative",
            "title": "Enrolled students",
            "scale": {
              "range": [150, 3500]
            }
          },

          "color": {
            "field": "average_score",
            "type": "quantitative",
            "title": "Average Numeracy score",
            "scale": {
              "scheme": "blues"
            }
          },

          "tooltip": [
            {
              "field": "state_territory",
              "type": "nominal",
              "title": "State / Territory"
            },
            {
              "field": "average_score",
              "type": "quantitative",
              "title": "Average score",
              "format": ".1f"
            },
            {
              "field": "enrolled_students",
              "type": "quantitative",
              "title": "Enrolled students",
              "format": ","
            },
            {
              "field": "participation_pct",
              "type": "quantitative",
              "title": "Participation",
              "format": ".1f"
            }
          ]
        }
      }
    ],

    "config": {
      "view": {
        "stroke": null
      },

      "legend": {
        "orient": "bottom"
      }
    }
  }
