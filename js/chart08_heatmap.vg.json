{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "title": {
      "text": "Achievement patterns differ across year levels and domains",
      "subtitle": "Students achieving Strong or above nationally, 2023–2026",
      "anchor": "start",
      "fontSize": 22,
      "subtitleFontSize": 13,
      "subtitlePadding": 8
    },

    "data": {
      "url": "data/naplan_national.csv",
      "format": {
        "type": "csv",
        "parse": {
          "calendar_year": "number",
          "year_level": "number",
          "strong_or_above_pct": "number",
          "average_score": "number",
          "participation_pct": "number"
        }
      }
    },

    "facet": {
      "column": {
        "field": "domain",
        "type": "nominal",
        "title": null,
        "sort": ["Reading", "Numeracy"],
        "header": {
          "labelFontSize": 17,
          "labelFontWeight": "bold",
          "labelPadding": 10
        }
      }
    },

    "spec": {
      "width": 280,
      "height": 280,

      "layer": [
        {
          "mark": {
            "type": "rect",
            "stroke": "white",
            "strokeWidth": 2,
            "cornerRadius": 3
          },

          "encoding": {
            "x": {
              "field": "calendar_year",
              "type": "ordinal",
              "title": "NAPLAN year",
              "sort": [2023, 2024, 2025, 2026],
              "axis": {
                "labelAngle": 0
              }
            },

            "y": {
              "field": "year_level",
              "type": "ordinal",
              "title": "Year level",
              "sort": [3, 5, 7, 9]
            },

            "color": {
              "field": "strong_or_above_pct",
              "type": "quantitative",
              "title": "Strong or above (%)",
              "scale": {
                "scheme": "blues"
              }
            },

            "tooltip": [
              {
                "field": "domain",
                "type": "nominal",
                "title": "Domain"
              },
              {
                "field": "calendar_year",
                "type": "ordinal",
                "title": "Year"
              },
              {
                "field": "year_level",
                "type": "ordinal",
                "title": "Year level"
              },
              {
                "field": "strong_or_above_pct",
                "type": "quantitative",
                "title": "Strong or above",
                "format": ".1f"
              },
              {
                "field": "average_score",
                "type": "quantitative",
                "title": "Average score",
                "format": ".1f"
              },
              {
                "field": "participation_pct",
                "type": "quantitative",
                "title": "Participation",
                "format": ".1f"
              }
            ]
          }
        },

        {
          "mark": {
            "type": "text",
            "fontSize": 13,
            "fontWeight": "bold"
          },

          "encoding": {
            "x": {
              "field": "calendar_year",
              "type": "ordinal",
              "sort": [2023, 2024, 2025, 2026]
            },

            "y": {
              "field": "year_level",
              "type": "ordinal",
              "sort": [3, 5, 7, 9]
            },

            "text": {
              "field": "strong_or_above_pct",
              "type": "quantitative",
              "format": ".0f"
            },

            "color": {
              "condition": {
                "test": "datum.strong_or_above_pct >= 65",
                "value": "white"
              },
              "value": "#222222"
            }
          }
        }
      ]
    },

    "resolve": {
      "scale": {
        "color": "shared"
      }
    },

    "config": {
      "view": {
        "stroke": null
      },

      "legend": {
        "orient": "bottom",
        "direction": "horizontal"
      }
    }
  }
